# Copy to .env and fill in. NEVER commit .env.

# ── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
# Pooled (Supavisor, :6543) for the api; direct (:5432) for workers.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Only if your project still uses the legacy HS256 JWT secret:
SUPABASE_JWT_SECRET=

# Frontend (Vite exposes only VITE_* to the browser — anon key only!)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
VITE_API_URL=http://localhost:8080

# ── Zerodha Kite Connect (backend only, never VITE_) ────────────────
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# ── Runtime ─────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
